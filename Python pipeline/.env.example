# Copy to .env and fill in. .env is gitignored - never commit real keys.

# OpenAI API key for the summarization / translation / extraction layer
OPENAI_API_KEY=sk-...

# Model used for structured extraction (a mini/nano tier is plenty - see ARCHITECTURE.md section 10)
OPENAI_MODEL=gpt-4o-mini

# Shared password for the internal Flask demo (see ARCHITECTURE.md section 12)
APP_PASSWORD=changeme

# --------------------------------------------------------------------------- #
# Gmail inbox (Google Alerts) over IMAP
# --------------------------------------------------------------------------- #
# The client's Gmail needs:
#   1. 2-Step Verification ON  (https://myaccount.google.com/security)
#   2. IMAP enabled           (Gmail Settings > Forwarding and POP/IMAP)
#   3. An App Password        (https://myaccount.google.com/apppasswords)
#      Name it "AI4Good Press Monitor", copy the 16-char code here (spaces optional).
GMAIL_IMAP_USER=the-client-address@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
IMAP_HOST=imap.gmail.com
ALERT_SENDER=googlealerts-noreply@google.com
ALERT_SINCE_DAYS=7
